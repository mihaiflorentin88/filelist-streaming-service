# Cross-compile this repo's Wails v3 linux GUI targets
#
# Derived VERBATIM from the Dockerfile.cross shipped by `wails3 init`
# (wails3 CLI v3.0.0-beta.16), trimmed to the linux cross toolchain this
# repo builds. Deviations from the canonical template (kept in the wails
# init template output and upstream pkg source):
#   - macOS SDK download removed: darwin builds are native on a macOS host
#     (spec: `wails3 build`/`package`); the SDK download also failed
#     repeatedly under BuildKit (works in a plain container) and the
#     zcc-darwin wrappers are unusable without it.
#   - Zig + windows zcc wrappers removed: this repo's windows release
#     binaries are cgo-free (CGO_ENABLED=0 go build) and the linux targets
#     use the native gcc below; zig existed only to serve those wrappers.
# The Makefile invokes this image with an explicit `--entrypoint go` (see
# build-arm64), so build.sh is retained only for canonical parity.
#
# Canonical usage (still works):
#   docker build -t wails-cross -f Dockerfile.cross .
#   docker run --rm -v $(pwd):/app wails-cross linux arm64
#   docker run --rm -v $(pwd):/app wails-cross linux amd64   (add --platform linux/amd64 on arm64 hosts)

# Debian 13 provides both the GTK3 (gtk+-3.0 + webkit2gtk-4.1) packages the
# `gtk3` build tag needs and the GTK >= 4.14 baseline of the default backend.
FROM golang:1.26-trixie

ARG GARBLE_VERSION=v0.16.0

# Install base tools, GCC, and GTK/WebKit dev packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl xz-utils python3 nodejs npm pkg-config gcc libc6-dev \
    libgtk-3-dev libwebkit2gtk-4.1-dev \
    libgtk-4-dev libwebkitgtk-6.0-dev \
    && pkg-config --atleast-version=4.14 gtk4 \
    && pkg-config --exists webkitgtk-6.0 \
    && pkg-config --exists gtk+-3.0 \
    && pkg-config --exists webkit2gtk-4.1 \
    && rm -rf /var/lib/apt/lists/*

RUN go install mvdan.cc/garble@${GARBLE_VERSION}

# Build script
COPY <<'SCRIPT' /usr/local/bin/build.sh
#!/bin/sh
set -e

OS=${1:-darwin}
ARCH=${2:-arm64}

case "${OS}-${ARCH}" in
    linux-arm64|linux-aarch64)
        export CC=gcc
        export GOARCH=arm64
        export GOOS=linux
        ;;
    linux-amd64|linux-x86_64)
        export CC=gcc
        export GOARCH=amd64
        export GOOS=linux
        ;;
    *)
        echo "Usage: <os> <arch>"
        echo "  os: linux"
        echo "  arch: amd64, arm64"
        exit 1
        ;;
esac

export CGO_ENABLED=1
export CGO_CFLAGS="-w"

# Build frontend if exists and not already built (host may have built it)
if [ -d "frontend" ] && [ -f "frontend/package.json" ] && [ ! -d "frontend/dist" ]; then
    (cd frontend && npm install --silent && npm run build --silent)
fi

# Build
APP=${APP_NAME:-$(basename $(pwd))}
mkdir -p bin

EXT=""
LDFLAGS="-s -w"

TAGS="production"
if [ -n "$EXTRA_TAGS" ]; then
    TAGS="${TAGS},${EXTRA_TAGS}"
fi

COMPILER="go build"
if [ "$OBFUSCATED" = "true" ]; then
    COMPILER="garble ${GARBLE_ARGS} build"
    TAGS="${TAGS},wails_obfuscated"
fi

${COMPILER} -tags "$TAGS" -trimpath -buildvcs=false -ldflags="$LDFLAGS" -o bin/${APP}-${GOOS}-${GOARCH}${EXT} .
echo "Built: bin/${APP}-${GOOS}-${GOARCH}${EXT}"
SCRIPT
RUN chmod +x /usr/local/bin/build.sh

WORKDIR /app
ENTRYPOINT ["/usr/local/bin/build.sh"]
CMD ["linux", "arm64"]
