[Unit]
Description=FileList Streaming Service
After=network-online.target qbittorrent-nox.service
Wants=network-online.target

[Service]
Type=simple
User=filelist-streaming
Group=filelist-streaming
SupplementaryGroups=qbittorrent
WorkingDirectory=/var/lib/filelist-streaming
ExecStart=/usr/local/bin/filelist-streaming
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# pi-deploy.sh substitutes @DOWNLOAD_ROOT@ with the configured download root:
# the native engine writes media and session state there, so the sandbox must
# allow it. The leading dash tolerates a not-yet-created path. Never list the
# download root (or any writable path) below: systemd applies these lines in
# order, and a later mention re-mutes an earlier grant.
ReadWritePaths=/var/lib/filelist-streaming -@DOWNLOAD_ROOT@
ReadOnlyPaths=-/var/lib/qbittorrent/qBittorrent/downloads
MemoryHigh=1536M
MemoryMax=2G
CPUQuota=250%
TasksMax=256
IOWeight=50
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
