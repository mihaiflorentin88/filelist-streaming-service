FROM node:24-bookworm-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7 AS frontend
WORKDIR /src
COPY package.json package-lock.json ./
COPY web/package.json web/package.json
COPY clients/shared/package.json clients/shared/package.json
COPY clients/tizen/package.json clients/tizen/package.json
RUN npm ci
COPY web web
COPY clients clients
RUN npm run build:web

FROM golang:1.26.5-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /src/internal/adapters/httpapi/static ./internal/adapters/httpapi/static
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/mihaiflorentin88/filelist-streaming-service/internal/composition.Version=${VERSION}" -o /out/filelist-streaming ./cmd/server

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg python3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 filelist \
    && useradd --uid 10001 --gid 10001 --home-dir /var/lib/filelist-streaming --shell /usr/sbin/nologin filelist
WORKDIR /var/lib/filelist-streaming
COPY --from=build /out/filelist-streaming /usr/local/bin/filelist-streaming
COPY tools/progressive_stream_smoke.py /usr/local/bin/progressive_stream_smoke.py
RUN mkdir -p /var/lib/filelist-streaming/data && chown -R filelist:filelist /var/lib/filelist-streaming
USER filelist:filelist
EXPOSE 8097
VOLUME ["/var/lib/filelist-streaming"]
HEALTHCHECK --interval=10s --timeout=4s --start-period=20s --retries=12 CMD curl -fsS http://127.0.0.1:8097/api/v1/system/info >/dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/filelist-streaming"]
