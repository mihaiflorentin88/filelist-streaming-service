{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "skipLibCheck": true
  },
  "include": [
    "src.tsx",
    "assets.d.ts",
    "audio-decode.ts",
    "audio-decode-worker.ts",
    "../clients/shared/src"
